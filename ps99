-- Functions
local function hatchEgg()
    local hatchNames = {"HatchEgg", "Hatch", "StartHatch", "BuyEgg", "SpawnPet", "EggHatch", "HatchPet"}
    for _, name in pairs(hatchNames) do
        if remotes[name] then
            remotes[name]:FireServer()
            task.wait(0.2)
            return true
        end
    end
    return false
end

